# Copy to .env and adjust. Read by docker compose and, when running without
# Docker, by credentials.py.

# Where the WEB SDK token is requested from.
WEB_SDK_TOKEN_URL=https://global-customer-frontend.365id.com/api/v1/websdktoken

# The origin(s) the SDK is allowed to run on.
#ALLOWED_ORIGIN=*://websdk.example.com/*
ALLOWED_ORIGIN=*://localhost/*

# Where the user is sent when transferring to a second device.
#TRANSFER_DEVICE_DOMAIN_URL=https://websdk.example.com/transfer_to_second_device
TRANSFER_DEVICE_DOMAIN_URL=http://localhost:5001/transfer_to_second_device

# Flask session signing key. A random one is generated per start if left empty.
FLASK_SECRET_KEY=

# Your License Key. With Docker Compose these are passed in as secrets and
# appear inside the container as files under /run/secrets/.
CLIENT_ID=
CLIENT_SECRET=
